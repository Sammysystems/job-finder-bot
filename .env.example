# --- Sources ---------------------------------------------------------------
# Data source: "stub" for offline fixtures, otherwise the registry fans out
JOB_SOURCE=ashby

# Comma-separated sources for the registry (leave empty to enable all).
# Values: ashby, remotive, jobicy, arbeitnow, remoteok, wwr
JOB_SOURCES=

# Comma-separated Ashby org slugs, e.g. lemfi,supabase
ASHBY_ORGS=lemfi,supabase

# Arbeitnow crawl controls (optional)
ARBEITNOW_MAX_AGE_DAYS=7
ARBEITNOW_MAX_PAGES=8

# --- Delivery --------------------------------------------------------------
# Telegram alerts (leave blank to log-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Outreach identity -----------------------------------------------------
# Display name used in the email signature and From header
SENDER_NAME=AI Automation Engineer

# Portfolio link appended to each draft
SENDER_GITHUB=https://github.com/Sammysystems

# --- Optional: Gmail send path --------------------------------------------
# Not required. Drafts are delivered to Telegram for manual sending by default.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Optional: hosted store ------------------------------------------------
# Later: move the JSON store into Postgres / InsForge
INSFORGE_URL=
INSFORGE_API_KEY=
