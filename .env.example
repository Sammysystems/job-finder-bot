# --- Sources ---------------------------------------------------------------
# Data source: "stub" for offline fixtures, "registry" for curated role sources
JOB_SOURCE=registry

# Empty uses curated defaults: remotive, jobicy, arbeitnow, wwr, hn.
# "all" opts into every source; technical-only Ashby and Remote OK are excluded by default.
JOB_SOURCES=

# Comma-separated Ashby org slugs, e.g. lemfi,supabase
ASHBY_ORGS=lemfi,supabase

# Arbeitnow crawl controls (optional)
ARBEITNOW_MAX_AGE_DAYS=7
ARBEITNOW_MAX_PAGES=8

# --- Delivery --------------------------------------------------------------
# Telegram alerts (leave blank to log-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Outreach identity -----------------------------------------------------
# Display name used in the application-draft signature
SENDER_NAME=Your Name

# --- Optional: hosted store ------------------------------------------------
# Later: move the JSON store into Postgres / InsForge
INSFORGE_URL=
INSFORGE_API_KEY=
